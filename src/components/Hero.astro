---
import es from '../i18n/es';
import en from '../i18n/en';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEn = lang === 'en';
---

<section class="hero-section relative min-h-screen flex flex-col justify-center overflow-hidden">
  <!-- Video/Image Background -->
  <div class="hero-bg absolute inset-0 w-full h-full">
    <img
      src="https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=1920&q=80"
      alt="Carretera panorámica"
      class="w-full h-full object-cover scale-110"
      loading="eager"
    />
    <!-- Multi-layer overlay -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,10,26,0.85) 0%, rgba(0,0,255,0.4) 50%, rgba(10,10,26,0.8) 100%);"></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,10,26,0.9) 0%, transparent 40%);"></div>
  </div>

  <!-- Decorative elements -->
  <div class="absolute top-20 right-10 w-72 h-72 rounded-full blur-3xl opacity-20" style="background: #0000ff;"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 rounded-full blur-3xl opacity-15" style="background: #f27949;"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-12">
    <div class="max-w-3xl">
      <!-- Badge -->
      <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8" style="background: rgba(242,121,73,0.15); border: 1px solid rgba(242,121,73,0.3);">
        <span class="w-2 h-2 rounded-full animate-pulse" style="background: #f27949;"></span>
        <span class="text-sm font-semibold" style="color: #f27949;">{t.hero.badge}</span>
      </div>

      <!-- Title -->
      <h1 class="hero-title font-extrabold text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-tight mb-6" style="font-family: 'Playfair Display', serif;">
        {t.hero.title.split(' ').map((word, i) => (
          <span class={`hero-word inline-block ${i >= 2 ? 'gradient-text' : ''}`}>{word}&nbsp;</span>
        ))}
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle text-white/70 text-lg sm:text-xl md:text-2xl leading-relaxed mb-10 max-w-2xl">
        {t.hero.subtitle}
      </p>

      <!-- CTAs -->
      <div class="hero-cta flex flex-wrap gap-4">
        <a href={isEn ? '/en/contact' : '/contacto'} class="btn-accent text-lg gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {t.hero.cta}
        </a>
        <a href="#services" class="btn-outline text-lg gap-2">
          {t.hero.ctaSecondary}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator (normal flow) -->
  <div class="hero-scroll relative z-10 flex flex-col items-center gap-2 text-white/50 mt-10 pb-8">
    <span class="text-xs uppercase tracking-widest">{t.hero.scroll}</span>
    <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center pt-2">
      <div class="w-1.5 h-3 rounded-full animate-bounce" style="background: #f27949;"></div>
    </div>
  </div>
</section>

<style>
  .gradient-text {
    background: linear-gradient(135deg, #f27949, #ff9a76);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from('.hero-badge', { opacity: 0, y: 30, duration: 0.8, delay: 0.3 })
      .from('.hero-word', { opacity: 0, y: 60, duration: 0.6, stagger: 0.08 }, '-=0.4')
      .from('.hero-subtitle', { opacity: 0, y: 30, duration: 0.8 }, '-=0.3')
      .from('.hero-cta', { opacity: 0, y: 30, duration: 0.8 }, '-=0.4')
      .from('.hero-scroll', { opacity: 0, y: -20, duration: 0.8 }, '-=0.2');
  });
</script>
