---
import es from '../i18n/es';
import en from '../i18n/en';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEn = lang === 'en';

const navLinks = [
  { href: isEn ? '/en/' : '/', label: t.nav.home },
  { href: isEn ? '/en/about' : '/nosotros', label: t.nav.about },
  { href: isEn ? '/en/services' : '/servicios', label: t.nav.services },
  { href: isEn ? '/en/fleet' : '/flota', label: t.nav.fleet },
  { href: isEn ? '/en/contact' : '/contacto', label: t.nav.contact },
];

const currentPath = Astro.url.pathname;

// Route mapping between ES ↔ EN
const routeMap: Record<string, string> = {
  '/': '/en/',
  '/nosotros': '/en/about',
  '/servicios': '/en/services',
  '/flota': '/en/fleet',
  '/contacto': '/en/contact',
};
const reverseRouteMap: Record<string, string> = {
  '/en/': '/',
  '/en/about': '/nosotros',
  '/en/services': '/servicios',
  '/en/fleet': '/flota',
  '/en/contact': '/contacto',
};

const enUrl = routeMap[currentPath] ?? '/en/';
const esUrl = reverseRouteMap[currentPath] ?? '/';
---

<nav class="navbar fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href={isEn ? '/en/' : '/'} class="flex items-center gap-3 group">
        <div class="w-10 h-10 lg:w-12 lg:h-12 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
          <svg class="w-6 h-6 lg:w-7 lg:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
          </svg>
        </div>
        <div class="hidden sm:block">
          <span class="font-extrabold text-base lg:text-lg text-white leading-tight block" style="font-family: 'Playfair Display', serif;">Multiservicios</span>
          <span class="text-xs lg:text-sm font-medium" style="color: #f27949;">Martínez González</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && link.href !== '/en/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 ${isActive ? 'text-white' : 'text-white/80 hover:text-white hover:bg-white/10'}`}
            >
              {link.label}
              {isActive && <span class="block h-0.5 rounded-full mt-0.5" style="background: #f27949;"></span>}
            </a>
          );
        })}
      </div>

      <!-- Right side: CTA + Language + Mobile menu -->
      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <div class="flex items-center bg-white/10 backdrop-blur-sm rounded-lg overflow-hidden text-sm font-semibold">
          <a
            href={esUrl}
            class={`px-3 py-1.5 transition-all duration-300 ${!isEn ? 'bg-white text-[#0a0a1a]' : 'text-white/70 hover:text-white'}`}
          >
            ES
          </a>
          <a
            href={enUrl}
            class={`px-3 py-1.5 transition-all duration-300 ${isEn ? 'bg-white text-[#0a0a1a]' : 'text-white/70 hover:text-white'}`}
          >
            EN
          </a>
        </div>

        <!-- CTA Button Desktop -->
        <a
          href={isEn ? '/en/contact' : '/contacto'}
          class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-bold text-sm text-white transition-all duration-300 hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, #f27949, #e06838); box-shadow: 0 4px 15px rgba(242,121,73,0.3);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {t.nav.cta}
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-lg text-white hover:bg-white/10 transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden">
    <div class="px-4 pb-6 pt-2 space-y-1" style="background: rgba(10,10,26,0.98); backdrop-filter: blur(20px);">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 rounded-lg text-white/80 hover:text-white hover:bg-white/10 font-medium transition-all"
        >
          {link.label}
        </a>
      ))}
      <a
        href={isEn ? '/en/contact' : '/contacto'}
        class="block mt-4 text-center px-6 py-3 rounded-lg font-bold text-white"
        style="background: linear-gradient(135deg, #f27949, #e06838);"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background: transparent;
  }
  .navbar-scrolled {
    background: rgba(10, 10, 26, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = btn?.querySelector('.menu-icon');
  const closeIcon = btn?.querySelector('.close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
