---
import es from '../i18n/es';
import en from '../i18n/en';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEn = lang === 'en';

const services = [
  {
    key: 'airport',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>`,
    image: 'https://images.unsplash.com/photo-1436491865332-7a61a109db05?w=800&q=80',
    ...t.services.items.airport,
  },
  {
    key: 'hotels',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    image: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80',
    ...t.services.items.hotels,
  },
  {
    key: 'tours',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80',
    ...t.services.items.tours,
  },
  {
    key: 'nicaraguaHonduras',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
    image: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=800&q=80',
    ...t.services.items.nicaraguaHonduras,
  },
  {
    key: 'nicaraguaElSalvador',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
    image: 'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=800&q=80',
    ...t.services.items.nicaraguaElSalvador,
  },
  {
    key: 'corporate',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    image: 'https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?w=800&q=80',
    ...t.services.items.corporate,
  },
];
---

<section id="services" class="section-padding" style="background: #f8f9fa;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-4" style="background: rgba(0,0,255,0.1); color: #0000ff;">
        {isEn ? 'What We Offer' : 'Lo Que Ofrecemos'}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-4" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
        {t.services.sectionTitle}
      </h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">{t.services.sectionSubtitle}</p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, i) => (
        <div class="reveal group relative overflow-hidden rounded-2xl bg-white shadow-lg hover-lift cursor-pointer" style={`animation-delay: ${i * 100}ms;`}>
          <!-- Image -->
          <div class="relative h-56 overflow-hidden">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
            <!-- Icon overlay -->
            <div class="absolute top-4 right-4 w-14 h-14 rounded-xl flex items-center justify-center text-white transition-all duration-300 group-hover:scale-110" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
              <Fragment set:html={service.icon} />
            </div>
            <!-- Title on image -->
            <div class="absolute bottom-4 left-4 right-4">
              <h3 class="text-xl font-bold text-white">{service.title}</h3>
            </div>
          </div>
          <!-- Content -->
          <div class="p-6">
            <p class="text-gray-600 leading-relaxed">{service.description}</p>
            <div class="mt-4 flex items-center gap-2 font-semibold text-sm transition-colors duration-300" style="color: #0000ff;">
              <span>{isEn ? 'Learn more' : 'Más información'}</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
