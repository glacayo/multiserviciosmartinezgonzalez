---
import es from '../i18n/es';
import en from '../i18n/en';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEn = lang === 'en';

const vehicles = [
  {
    brand: 'Hyundai',
    model: 'Grand i10',
    type: 'Sedán',
    year: '2026',
    color: 'Gris',
    image: 'https://images.unsplash.com/photo-1619767886558-efdc259cde1a?w=800&q=80',
    passengers: 4,
    features: [t.fleet.features.ac, t.fleet.features.luggage],
  },
  {
    brand: 'Hyundai',
    model: 'Avante',
    type: 'Sedán',
    year: '2015',
    color: 'Blanco',
    image: 'https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?w=800&q=80',
    passengers: 4,
    features: [t.fleet.features.ac, t.fleet.features.luggage, t.fleet.features.leather],
  },
  {
    brand: 'Kia',
    model: 'Rio',
    type: 'Sedán',
    year: '2017',
    color: 'Rojo',
    image: 'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=800&q=80',
    passengers: 4,
    features: [t.fleet.features.ac, t.fleet.features.luggage, t.fleet.features.wifi],
  },
];
---

<section class="section-padding relative overflow-hidden" style="background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-4" style="background: rgba(0,0,255,0.1); color: #0000ff;">
        {isEn ? 'Our Fleet' : 'Nuestra Flota'}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-4" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
        {t.fleet.sectionTitle}
      </h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">{t.fleet.sectionSubtitle}</p>
    </div>

    <!-- Vehicle Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {vehicles.map((vehicle, i) => (
        <div class="reveal group relative overflow-hidden rounded-2xl bg-white shadow-xl hover-lift" style={`animation-delay: ${i * 150}ms;`}>
          <!-- Image -->
          <div class="relative h-64 overflow-hidden">
            <img
              src={vehicle.image}
              alt={`${vehicle.brand} ${vehicle.model}`}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <!-- Year badge -->
            <div class="absolute top-4 left-4 px-3 py-1.5 rounded-lg text-white text-sm font-bold" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
              {vehicle.year}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h3 class="text-xl font-bold" style="color: #0a0a1a;">{vehicle.brand}</h3>
                <p class="text-gray-500 font-medium">{vehicle.model}</p>
              </div>
              <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(0,0,255,0.1);">
                <svg class="w-5 h-5" style="color: #0000ff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
            </div>

            <!-- Specs -->
            <div class="flex items-center gap-4 mb-4 py-3 border-t border-b" style="border-color: #f0f0f0;">
              <div class="flex items-center gap-1.5 text-sm text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {vehicle.passengers} {t.fleet.passengers}
              </div>
              <div class="flex items-center gap-1.5 text-sm text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
                {vehicle.type}
              </div>
              <div class="flex items-center gap-1.5 text-sm text-gray-500">
                <span class="w-3 h-3 rounded-full border-2" style={`border-color: ${vehicle.color === 'Gris' ? '#9ca3af' : vehicle.color === 'Blanco' ? '#e5e7eb' : '#ef4444'}; background: ${vehicle.color === 'Gris' ? '#9ca3af' : vehicle.color === 'Blanco' ? '#ffffff' : '#ef4444'};`}></span>
                {isEn ? (vehicle.color === 'Gris' ? 'Grey' : vehicle.color === 'Blanco' ? 'White' : 'Red') : vehicle.color}
              </div>
            </div>

            <!-- Features -->
            <div class="flex flex-wrap gap-2">
              {vehicle.features.map((feat) => (
                <span class="px-3 py-1 rounded-full text-xs font-medium" style="background: rgba(0,0,255,0.08); color: #0000ff;">
                  {feat}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
