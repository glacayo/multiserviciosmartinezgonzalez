---
import es from '../i18n/es';
import en from '../i18n/en';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEn = lang === 'en';

const features = [
  {
    ...t.whyUs.features.safety,
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    ...t.whyUs.features.punctual,
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    ...t.whyUs.features.personalized,
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
  },
  {
    ...t.whyUs.features.experience,
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
  },
];
---

<section class="section-padding relative overflow-hidden" style="background: #0a0a1a;">
  <!-- Decorative blurs -->
  <div class="absolute top-0 left-0 w-96 h-96 rounded-full blur-3xl opacity-10" style="background: #0000ff;"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full blur-3xl opacity-10" style="background: #f27949;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Image Side -->
      <div class="reveal-left relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=800&q=80"
            alt="Servicio de transporte premium"
            class="w-full h-[500px] object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(0,0,255,0.3), transparent);"></div>
        </div>
        <!-- Floating stat card -->
        <div class="absolute -bottom-6 -right-6 glass-card p-6 shadow-2xl" style="background: rgba(255,255,255,0.95);">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #f27949, #e06838);">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <div class="text-3xl font-extrabold" style="color: #0a0a1a;">1000+</div>
              <div class="text-gray-500 text-sm font-medium">{isEn ? 'Happy Clients' : 'Clientes Felices'}</div>
            </div>
          </div>
        </div>
        <!-- Decorative border -->
        <div class="absolute -top-4 -left-4 w-full h-full rounded-2xl border-2 -z-10" style="border-color: rgba(0,0,255,0.3);"></div>
      </div>

      <!-- Content Side -->
      <div class="reveal-right">
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background: rgba(242,121,73,0.15); color: #f27949;">
          {isEn ? 'Why Choose Us' : '¿Por Qué Nosotros?'}
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6" style="font-family: 'Playfair Display', serif;">
          {t.whyUs.sectionTitle}
        </h2>
        <p class="text-white/60 text-lg leading-relaxed mb-10">
          {t.whyUs.description}
        </p>

        <!-- Features -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {features.map((feature) => (
            <div class="flex items-start gap-4 p-4 rounded-xl transition-all duration-300 hover:bg-white/5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(242,121,73,0.15); color: #f27949;">
                <Fragment set:html={feature.icon} />
              </div>
              <div>
                <h4 class="font-bold text-white mb-1">{feature.title}</h4>
                <p class="text-white/50 text-sm">{feature.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
