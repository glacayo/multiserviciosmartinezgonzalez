---
import Layout from '../layouts/Layout.astro';
import es from '../i18n/es';

const t = es;

const serviceOptions = [
  'Traslados Aeropuerto',
  'Traslados Hoteles',
  'Tours Nacionales',
  'Nicaragua / Honduras',
  'Nicaragua / El Salvador',
  'Traslado de Personal Empresas',
];
---

<Layout title="Contáctanos" description="Contáctanos para reservar tu traslado. Disponibles 24/7 en Carretera nueva león km10 1/2, Residencial San Miguel." lang="es">
  <!-- Page Hero -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1920&q=80"
        alt="Contacto"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,10,26,0.9) 0%, rgba(0,0,255,0.5) 100%);"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16">
      <div class="reveal max-w-2xl">
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background: rgba(242,121,73,0.15); color: #f27949; border: 1px solid rgba(242,121,73,0.3);">
          Estamos Para Ayudarte
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6" style="font-family: 'Playfair Display', serif;">
          {t.contactPage.heroTitle}
        </h1>
        <p class="text-white/70 text-xl">{t.contactPage.heroSubtitle}</p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding" style="background: #ffffff;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-2 reveal-left">
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-8" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
            {t.contactPage.infoTitle}
          </h2>

          <div class="space-y-6">
            <!-- Address -->
            <div class="flex items-start gap-4 p-5 rounded-xl transition-all duration-300 hover:shadow-lg" style="background: rgba(0,0,255,0.03);">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1" style="color: #0a0a1a;">{t.contactPage.address}</h3>
                <p class="text-gray-500">Carretera nueva león km10 1/2<br/>Residencial San Miguel</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4 p-5 rounded-xl transition-all duration-300 hover:shadow-lg" style="background: rgba(242,121,73,0.03);">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #f27949, #e06838);">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1" style="color: #0a0a1a;">Teléfono</h3>
                <p class="text-gray-500">+505 0000 0000</p>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-4 p-5 rounded-xl transition-all duration-300 hover:shadow-lg" style="background: rgba(37,211,102,0.03);">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #25d366, #128c7e);">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1" style="color: #0a0a1a;">WhatsApp</h3>
                <p class="text-gray-500">+505 0000 0000</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4 p-5 rounded-xl transition-all duration-300 hover:shadow-lg" style="background: rgba(0,0,255,0.03);">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1" style="color: #0a0a1a;">Email</h3>
                <p class="text-gray-500">info@multiserviciosmg.com</p>
              </div>
            </div>

            <!-- Schedule -->
            <div class="flex items-start gap-4 p-5 rounded-xl transition-all duration-300 hover:shadow-lg" style="background: rgba(242,121,73,0.03);">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #f27949, #e06838);">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-lg mb-1" style="color: #0a0a1a;">{t.contactPage.schedule}</h3>
                <p class="text-gray-500">24/7 - {t.contactPage.scheduleText}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3 reveal-right">
          <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-10 border" style="border-color: #f0f0f0;">
            <h2 class="text-2xl sm:text-3xl font-extrabold mb-2" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
              {t.contactPage.formTitle}
            </h2>
            <p class="text-gray-500 mb-8">Completa el formulario y nos pondremos en contacto contigo.</p>

            <form class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-semibold mb-2" style="color: #0a0a1a;">{t.contactPage.form.name}</label>
                  <input
                    type="text"
                    placeholder={t.contactPage.form.name}
                    class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none transition-colors duration-300"
                  />
                </div>
                <div>
                  <label class="block text-sm font-semibold mb-2" style="color: #0a0a1a;">{t.contactPage.form.email}</label>
                  <input
                    type="email"
                    placeholder={t.contactPage.form.email}
                    class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none transition-colors duration-300"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-semibold mb-2" style="color: #0a0a1a;">{t.contactPage.form.phone}</label>
                  <input
                    type="tel"
                    placeholder="+505 0000 0000"
                    class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none transition-colors duration-300"
                  />
                </div>
                <div>
                  <label class="block text-sm font-semibold mb-2" style="color: #0a0a1a;">{t.contactPage.form.service}</label>
                  <select class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none transition-colors duration-300 bg-white">
                    <option value="">Seleccionar servicio</option>
                    {serviceOptions.map((opt) => (
                      <option value={opt}>{opt}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div>
                <label class="block text-sm font-semibold mb-2" style="color: #0a0a1a;">{t.contactPage.form.message}</label>
                <textarea
                  rows="5"
                  placeholder="Cuéntanos sobre tu viaje..."
                  class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none transition-colors duration-300 resize-none"
                ></textarea>
              </div>
              <button type="submit" class="btn-accent w-full text-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                {t.contactPage.form.send}
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="relative h-96 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1524661135-423995f22d0b?w=1920&q=80"
        alt="Mapa de ubicación"
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,10,26,0.7) 0%, rgba(0,0,255,0.4) 100%);"></div>
    </div>
    <div class="relative z-10 flex items-center justify-center h-full">
      <div class="reveal text-center glass-card p-8">
        <svg class="w-12 h-12 mx-auto mb-4" style="color: #f27949;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <h3 class="text-xl font-bold text-white mb-2">Carretera Nueva León km10 1/2</h3>
        <p class="text-white/70">Residencial San Miguel, Nicaragua</p>
      </div>
    </div>
  </section>
</Layout>
