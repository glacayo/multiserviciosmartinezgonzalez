---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import es from '../i18n/es';

const t = es;

const values = [
  { ...t.about.values.quality, icon: '⭐' },
  { ...t.about.values.trust, icon: '🤝' },
  { ...t.about.values.punctuality, icon: '⏰' },
  { ...t.about.values.excellence, icon: '🏆' },
];
---

<Layout title="Nosotros" description="Conoce la historia, misión y visión de Multiservicios Martínez González. Más de 6 años de experiencia en transporte privado." lang="es">
  <!-- Page Hero -->
  <section class="relative min-h-[60vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1920&q=80"
        alt="Carretera centroamericana"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,10,26,0.9) 0%, rgba(0,0,255,0.5) 100%);"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20">
      <div class="reveal max-w-2xl">
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background: rgba(242,121,73,0.15); color: #f27949; border: 1px solid rgba(242,121,73,0.3);">
          Desde 2020
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6" style="font-family: 'Playfair Display', serif;">
          {t.about.heroTitle}
        </h1>
        <p class="text-white/70 text-xl">{t.about.heroSubtitle}</p>
      </div>
    </div>
  </section>

  <!-- History Section -->
  <section class="section-padding" style="background: #ffffff;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal-left">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img
              src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800&q=80"
              alt="Fundadora María José González Villalta"
              class="w-full h-[450px] object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,10,26,0.6) 0%, transparent 50%);"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="text-white font-bold text-lg">María José González Villalta</p>
              <p class="text-white/70 text-sm">Fundadora & Directora</p>
            </div>
          </div>
        </div>
        <div class="reveal-right">
          <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6" style="background: rgba(0,0,255,0.1); color: #0000ff;">
            Nuestra Historia
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mb-6" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
            {t.about.historyTitle}
          </h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-8">
            {t.about.historyText}
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="p-4 rounded-xl" style="background: rgba(0,0,255,0.05);">
              <div class="text-3xl font-extrabold" style="color: #0000ff;">2020</div>
              <div class="text-gray-500 text-sm">Año de fundación</div>
            </div>
            <div class="p-4 rounded-xl" style="background: rgba(242,121,73,0.05);">
              <div class="text-3xl font-extrabold" style="color: #f27949;">6+</div>
              <div class="text-gray-500 text-sm">Años de experiencia</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section-padding" style="background: #0a0a1a;">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full blur-3xl" style="background: #0000ff;"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full blur-3xl" style="background: #f27949;"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white" style="font-family: 'Playfair Display', serif;">
          Nuestro Propósito
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Mission -->
        <div class="reveal glass-card p-8 lg:p-10">
          <div class="w-16 h-16 rounded-xl flex items-center justify-center mb-6" style="background: linear-gradient(135deg, #0000ff, #4d4dff);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4" style="font-family: 'Playfair Display', serif;">{t.about.missionTitle}</h3>
          <p class="text-white/70 leading-relaxed text-lg">
            Proporcionar a nuestros clientes servicios de calidad con una excelente logística que cubra de forma eficiente y personalizada sus necesidades y que contribuyan de manera efectiva.
          </p>
        </div>
        <!-- Vision -->
        <div class="reveal glass-card p-8 lg:p-10">
          <div class="w-16 h-16 rounded-xl flex items-center justify-center mb-6" style="background: linear-gradient(135deg, #f27949, #e06838);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4" style="font-family: 'Playfair Display', serif;">{t.about.visionTitle}</h3>
          <p class="text-white/70 leading-relaxed text-lg">
            Crear una empresa de referencia en el sector de transporte que sea reconocida por la calidad y excelencia en el desarrollo de su actividad, que genere valor a sus clientes y que consolide una posición diferenciada en el mercado internacional.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding" style="background: #f8f9fa;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-4" style="background: rgba(0,0,255,0.1); color: #0000ff;">
          Lo Que Nos Define
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold" style="font-family: 'Playfair Display', serif; color: #0a0a1a;">
          {t.about.valuesTitle}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value, i) => (
          <div class="reveal group text-center p-8 rounded-2xl bg-white shadow-lg hover-lift">
            <div class="text-5xl mb-4">{value.icon}</div>
            <h3 class="text-xl font-bold mb-2" style="color: #0a0a1a;">{value.title}</h3>
            <p class="text-gray-500">{value.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang="es" />
</Layout>
